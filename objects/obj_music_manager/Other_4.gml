if (room == rm_Test_room) || (room == rm_Test_room2)
{
	set_song_ingame(bgm1, 30, 60);
}

if (room == rm_Red_Forrest_Bridge) || (room == rm_Red_Forrest_Cabin)
{
	set_song_ingame(bgm2, 30, 60);
}

if (room == rm_title_screen)
{
	set_song_ingame(bgm_main_menu, 0, 30);
}

if (room == rm_Start_Area) || (room == rm_base)
{
	set_song_ingame(bgm_scenery, 30, 60);
}

if (room == rm_Title)
{
	set_song_ingame(bgm_intro, 30, 60);
}
if (room == rm_witch)
{
	set_song_ingame(bgm_witch, 30, 60)
}
if (room == rm_witch_room)
{
	set_song_ingame(bgm_witch_room, 30, 60)
}
if (room == rm_fall)
{
	set_song_ingame(snd_wind, 30,60)
}
if (room == rm_fall2)
{
	set_song_ingame(noone, 30,60)
}